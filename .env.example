# ===========================================
# Agent-7 Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider Settings
# Choose between "gemini" (cloud) or "ollama" (local)
AI_PROVIDER=gemini

# Ollama Local Settings (only used if AI_PROVIDER=ollama)
# Recommended vision model for screen analysis: llama3.2-vision
OLLAMA_MODEL=llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434

# Safety Settings
# CONFIRM_ALL = ask before every action
# CONFIRM_DANGEROUS = only ask before posts/messages/deletes (recommended)
# NO_CONFIRM = full autopilot (use at your own risk)
CONFIRMATION_LEVEL=CONFIRM_DANGEROUS

# Browser Settings
# Leave empty to use a fresh profile, or set path to your Chrome profile
# Example: /Users/yourname/Library/Application Support/Google/Chrome/Default
CHROME_PROFILE_PATH=

# Dashboard
DASHBOARD_PORT=7777

# Logging
LOG_SCREENSHOTS=true
LOG_LEVEL=INFO
